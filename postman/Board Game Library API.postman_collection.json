    {
      "name": "Seeded walkthrough",
      "item": [
        {
          "name": "Search available Catan",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/board-games?search=catan&categoryId={{strategyCategoryId}}&players=4&isAvailable=true&page=1&pageSize=20&sortBy=title&sortDirection=asc"
