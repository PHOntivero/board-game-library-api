    {
      "name": "Write examples",
      "item": [
        {
          "name": "Create category",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const demoSuffix = Date.now().toString();",
                  "pm.collectionVariables.set('demoSuffix', demoSuffix);",
                  "pm.environment.set('demoSuffix', demoSuffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Category created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('createdCategoryId', pm.response.json().id);",
                  "pm.environment.set('createdCategoryId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Interview Demo {{demoSuffix}}\"\n}" },
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Interview Demo Updated {{demoSuffix}}\",\n  \"isActive\": true\n}" },
            "url": "{{baseUrl}}/api/categories/{{createdCategoryId}}"
          }
        },
