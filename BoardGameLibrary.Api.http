@baseUrl = https://localhost:7080
@strategyCategoryId = 0198a000-0001-7000-8000-000000000001
@catanBoardGameId = 0198a000-0002-7000-8000-000000000001
@catanCopyId = 0198a000-0003-7000-8000-000000000001
@firstMemberId = 0198a000-0004-7000-8000-000000000001
@firstActiveLoanId = 0198a000-0005-7000-8000-000000000029
@createdCategoryId = {{createCategory.response.body.$.id}}
@createdBoardGameId = {{createBoardGame.response.body.$.id}}
@createdGameCopyId = {{createGameCopy.response.body.$.id}}
@createdMemberId = {{createMember.response.body.$.id}}
@createdLoanId = {{createLoan.response.body.$.id}}

### Liveness
GET {{baseUrl}}/health/live

### Readiness
GET {{baseUrl}}/health/ready

### OpenAPI document (Development and Testing only)
GET {{baseUrl}}/openapi/v1.json

### Search, filter, sort and paginate seeded board games
GET {{baseUrl}}/api/board-games?search=catan&categoryId={{strategyCategoryId}}&players=4&isAvailable=true&page=1&pageSize=20&sortBy=title&sortDirection=asc

### Get canonical Catan record
GET {{baseUrl}}/api/board-games/{{catanBoardGameId}}

### List Catan copies
GET {{baseUrl}}/api/board-games/{{catanBoardGameId}}/copies?sortBy=inventoryCode&sortDirection=asc

### Get canonical member
GET {{baseUrl}}/api/members/{{firstMemberId}}

### List active loans
GET {{baseUrl}}/api/loans?status=active&sortBy=loanedAtUtc&sortDirection=desc

### Get canonical active loan
GET {{baseUrl}}/api/loans/{{firstActiveLoanId}}

### Create a category
# @name createCategory
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "Interview Demo"
}

### Update the created category
PUT {{baseUrl}}/api/categories/{{createdCategoryId}}
Content-Type: application/json

{
  "name": "Interview Demo Updated",
  "isActive": true
}

### Create a board game in the new category
# @name createBoardGame
POST {{baseUrl}}/api/board-games
Content-Type: application/json

{
  "title": "Architecture Arena",
  "publisher": "Demo Publisher",
  "description": "A temporary record used by the reviewer walkthrough.",
  "publicationYear": 2024,
  "minPlayers": 2,
  "maxPlayers": 4,
  "playingTimeMinutes": 60,
  "categoryIds": ["{{createdCategoryId}}"]
}

### Update the created board game (full replacement of mutable fields)
PUT {{baseUrl}}/api/board-games/{{createdBoardGameId}}
Content-Type: application/json

{
  "title": "Architecture Arena: Revised",
  "publisher": "Demo Publisher",
  "description": "Updated during the reviewer walkthrough.",
  "publicationYear": 2025,
  "minPlayers": 2,
  "maxPlayers": 5,
  "playingTimeMinutes": 75,
  "categoryIds": ["{{createdCategoryId}}"],
  "isActive": true
}

### Create a physical copy
# @name createGameCopy
POST {{baseUrl}}/api/board-games/{{createdBoardGameId}}/copies
Content-Type: application/json

{
  "inventoryCode": "DEMO-COPY-001",
  "condition": "excellent",
  "acquiredOn": "2026-01-10"
}

### Update the physical copy
PUT {{baseUrl}}/api/game-copies/{{createdGameCopyId}}
Content-Type: application/json

{
  "inventoryCode": "DEMO-COPY-001",
  "condition": "good",
  "acquiredOn": "2026-01-10",
  "isActive": true
}

### Create a member
# @name createMember
POST {{baseUrl}}/api/members
Content-Type: application/json

{
  "memberNumber": "DEMO-001",
  "fullName": "Demo Member",
  "email": "demo.member@example.test",
  "phoneNumber": null,
  "joinedOn": "2026-01-10"
}

### Update the member
PUT {{baseUrl}}/api/members/{{createdMemberId}}
Content-Type: application/json

{
  "memberNumber": "DEMO-001",
  "fullName": "Demo Member Updated",
  "email": "demo.member@example.test",
  "phoneNumber": "+55 11 99999-0000",
  "joinedOn": "2026-01-10",
  "isActive": true
}

### Create a loan for the new copy and member
# @name createLoan
POST {{baseUrl}}/api/loans
Content-Type: application/json

{
  "memberId": "{{createdMemberId}}",
  "gameCopyId": "{{createdGameCopyId}}"
}

### Confirm that the borrowed copy is unavailable
GET {{baseUrl}}/api/game-copies/{{createdGameCopyId}}

### Duplicate active loan conflict (expected 409 game_copy_has_open_loan)
POST {{baseUrl}}/api/loans
Content-Type: application/json

{
  "memberId": "{{createdMemberId}}",
  "gameCopyId": "{{createdGameCopyId}}"
}

### Return the newly created loan
POST {{baseUrl}}/api/loans/{{createdLoanId}}/return

### Confirm that the returned copy is available again
GET {{baseUrl}}/api/game-copies/{{createdGameCopyId}}

### Deactivate the copy
PUT {{baseUrl}}/api/game-copies/{{createdGameCopyId}}
Content-Type: application/json

{
  "inventoryCode": "DEMO-COPY-001",
  "condition": "good",
  "acquiredOn": "2026-01-10",
  "isActive": false
}

### Inactive copy conflict (expected 409 inactive_game_copy)
POST {{baseUrl}}/api/loans
Content-Type: application/json

{
  "memberId": "{{createdMemberId}}",
  "gameCopyId": "{{createdGameCopyId}}"
}

### Reactivate the copy in damaged condition
PUT {{baseUrl}}/api/game-copies/{{createdGameCopyId}}
Content-Type: application/json

{
  "inventoryCode": "DEMO-COPY-001",
  "condition": "damaged",
  "acquiredOn": "2026-01-10",
  "isActive": true
}

### Damaged copy conflict (expected 409 damaged_game_copy)
POST {{baseUrl}}/api/loans
Content-Type: application/json

{
  "memberId": "{{createdMemberId}}",
  "gameCopyId": "{{createdGameCopyId}}"
}

### Overdue member conflict using seeded data (expected 409 member_has_overdue_loan)
POST {{baseUrl}}/api/loans
Content-Type: application/json

{
  "memberId": "{{firstMemberId}}",
  "gameCopyId": "{{catanCopyId}}"
}

### Example validation error
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": ""
}

### Example protected delete conflict (seeded category is associated)
DELETE {{baseUrl}}/api/categories/{{strategyCategoryId}}

### Example missing resource (expected 404 category_not_found)
GET {{baseUrl}}/api/categories/0198a000-ffff-7000-8000-ffffffffffff

### Return the canonical active loan (alternative; changes seeded demo state)
POST {{baseUrl}}/api/loans/{{firstActiveLoanId}}/return

### Canonical Catan copy details
GET {{baseUrl}}/api/game-copies/{{catanCopyId}}
